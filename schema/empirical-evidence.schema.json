{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlerror.dev/schema/empirical-evidence.schema.json",
  "title": "Atlerror Empirical Evidence",
  "type": "object",
  "required": ["schema_version", "kind", "experiment", "claims", "environment", "observations", "assertions", "result", "interpretation"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "kind": { "const": "empirical_evidence" },
    "experiment": {
      "type": "string",
      "pattern": "^experiment\\.[a-z0-9_]+(\\.[a-z0-9_]+)+$"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^claim\\.[a-z0-9_]+(\\.[a-z0-9_]+)+$"
      }
    },
    "environment": {
      "type": "object",
      "required": ["runtime", "runtime_version", "platform", "isolation"],
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "runtime_version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "isolation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "intervention": { "type": "object" },
    "observations": { "type": "object" },
    "assertions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "boolean" }
    },
    "result": {
      "type": "string",
      "enum": ["supports", "contradicts", "inconclusive"]
    },
    "interpretation": { "type": "string", "minLength": 1 },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
