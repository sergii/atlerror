{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlerror.dev/schema/agent-plan.schema.json",
  "title": "Atlerror agent plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "incident_id",
    "evidence_revision",
    "active_execution_enabled",
    "steps",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "agent_plan"},
    "incident_id": {"type": "string", "minLength": 1},
    "evidence_revision": {"type": "integer", "minimum": 0},
    "active_execution_enabled": {"type": "boolean"},
    "steps": {
      "type": "array",
      "items": {"$ref": "#/$defs/step"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionable",
        "probe_in_progress",
        "probe_session_expired",
        "blocked",
        "no_executor",
        "no_probe_needed",
        "no_discriminating_probe"
      ],
      "properties": {
        "actionable": {"type": "integer", "minimum": 0},
        "probe_in_progress": {"type": "integer", "minimum": 0},
        "probe_session_expired": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "no_executor": {"type": "integer", "minimum": 0},
        "no_probe_needed": {"type": "integer", "minimum": 0},
        "no_discriminating_probe": {"type": "integer", "minimum": 0},
        "workflow_recovery_required": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "runtime_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "boundaries": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      },
      "minProperties": 1
    },
    "begin_arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "scope": {"$ref": "#/$defs/runtime_scope"}
      }
    },
    "session_arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId"],
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^probe-session\\.[0-9a-f]{16}$"
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "probe_id",
        "executor_id",
        "started_at",
        "expires_at",
        "lifecycle_state",
        "diagnosis_revision",
        "matches_current_recommendation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^probe-session\\.[0-9a-f]{16}$"
        },
        "probe_id": {"type": "string", "minLength": 1},
        "executor_id": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "lifecycle_state": {"enum": ["active", "expired"]},
        "diagnosis_revision": {"type": "integer", "minimum": 0},
        "matches_current_recommendation": {"type": "boolean"}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "incident_id",
        "issue_kind",
        "fingerprint",
        "files",
        "resolution"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^probe-session\\.[0-9a-f]{16}$"
        },
        "incident_id": {"type": ["string", "null"]},
        "issue_kind": {"enum": ["orphan_session", "orphan_binding"]},
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "resolution": {"const": "discard_partial_state"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "target",
        "state",
        "reason",
        "recommended_probe",
        "registered",
        "executable_here",
        "executor_id",
        "operation",
        "arguments",
        "allowed",
        "requires_opt_in",
        "unavailable_reason",
        "fallback",
        "session"
      ],
      "properties": {
        "scope": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/runtime_scope"}
          ]
        },
        "target": {"type": ["string", "null"], "minLength": 1},
        "state": {
          "enum": [
            "actionable",
            "probe_in_progress",
            "probe_session_expired",
            "blocked",
            "no_executor",
            "no_probe_needed",
            "no_discriminating_probe",
            "workflow_recovery_required"
          ]
        },
        "reason": {
          "enum": [
            "ready_to_begin_recommended",
            "ready_to_finish_probe",
            "probe_in_progress_execution_disabled",
            "ready_to_abandon_expired_probe",
            "expired_probe_execution_disabled",
            "active_execution_disabled",
            "executor_unavailable",
            "no_registered_executor",
            "fewer_than_two_candidates",
            "no_discriminating_probe",
            "partial_probe_workflow_state"
          ]
        },
        "recommended_probe": {"type": ["string", "null"]},
        "registered": {"type": ["boolean", "null"]},
        "executable_here": {"type": ["boolean", "null"]},
        "executor_id": {"type": ["string", "null"]},
        "operation": {
          "oneOf": [
            {"type": "null"},
            {"const": "atlerror.probe.begin_recommended"},
            {"const": "atlerror.probe.finish"},
            {"const": "atlerror.probe.abandon"}
          ]
        },
        "arguments": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/begin_arguments"},
            {"$ref": "#/$defs/session_arguments"}
          ]
        },
        "allowed": {"type": "boolean"},
        "requires_opt_in": {"type": "boolean"},
        "unavailable_reason": {"type": ["string", "null"]},
        "fallback": {
          "enum": [
            "none",
            "enable_readonly_probe_tools",
            "restore_executor_availability",
            "gather_external_evidence",
            "reconcile_partial_workflow"
          ]
        },
        "session": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/session"}
          ]
        },
        "recovery": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/recovery"}
          ]
        }
      }
    }
  }
}
