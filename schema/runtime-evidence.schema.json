{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlerror.dev/schema/runtime-evidence.schema.json",
  "title": "Atlerror runtime evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "incident_id", "instances"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "runtime_evidence"},
    "incident_id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/instance"}
    }
  },
  "$defs": {
    "concept_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "scalar": {
      "type": ["number", "string", "boolean", "null"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": {
          "enum": ["metric", "log", "trace", "probe", "manual", "experiment", "synthetic", "other"]
        },
        "name": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "attributes": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entities": {
          "type": "array",
          "items": {"$ref": "#/$defs/concept_id"},
          "uniqueItems": true
        },
        "boundaries": {
          "type": "array",
          "items": {"$ref": "#/$defs/concept_id"},
          "uniqueItems": true
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      },
      "minProperties": 1
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {"$ref": "#/$defs/scalar"},
        "baseline": {"$ref": "#/$defs/scalar"},
        "delta": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "comparison": {
          "enum": ["above_baseline", "below_baseline", "equal", "changed", "present", "absent", "unknown"]
        }
      },
      "minProperties": 1
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "observation", "state", "observed_at", "confidence", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "observation": {"$ref": "#/$defs/concept_id"},
        "state": {"enum": ["observed", "absent"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "confidence": {"enum": ["low", "moderate", "high"]},
        "source": {"$ref": "#/$defs/source"},
        "scope": {"$ref": "#/$defs/scope"},
        "measurement": {"$ref": "#/$defs/measurement"},
        "labels": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "note": {"type": "string"}
      }
    }
  }
}
