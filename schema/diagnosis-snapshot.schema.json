{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlerror.dev/schema/diagnosis-snapshot.schema.json",
  "title": "Atlerror live diagnosis snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "incident_id",
    "generated_at",
    "as_of",
    "evidence_revision",
    "next_recompute_at",
    "partitions"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "diagnosis_snapshot"},
    "incident_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "as_of": {"type": "string", "format": "date-time"},
    "evidence_revision": {"type": "integer", "minimum": 0},
    "next_recompute_at": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "date-time"}
      ]
    },
    "partitions": {
      "type": "array",
      "items": {"$ref": "#/$defs/partition"}
    }
  },
  "$defs": {
    "runtime_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "boundaries": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      },
      "minProperties": 1
    },
    "ranking": {
      "type": "object",
      "required": ["schema_version", "kind", "query", "found", "ranking_method", "candidates"],
      "properties": {
        "schema_version": {"const": "0.1"},
        "kind": {"const": "causal_ranking"},
        "query": {
          "type": "object",
          "required": ["target", "observed", "absent", "max_depth"],
          "properties": {
            "target": {"type": "string", "minLength": 1},
            "observed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "absent": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "max_depth": {"type": ["integer", "null"], "minimum": 1}
          }
        },
        "found": {"const": true},
        "ranking_method": {"type": "object"},
        "evidence_context": {"type": "object"},
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["rank", "source", "path", "factors", "reasons"]
          }
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "ranking"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "ranking": {"$ref": "#/$defs/ranking"}
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "observed",
        "absent",
        "active_instance_ids",
        "stale_instance_ids",
        "future_instance_ids",
        "diagnoses",
        "unranked_observations"
      ],
      "properties": {
        "scope": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/runtime_scope"}
          ]
        },
        "observed": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "absent": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "active_instance_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "stale_instance_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "future_instance_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "diagnoses": {
          "type": "array",
          "items": {"$ref": "#/$defs/diagnosis"}
        },
        "unranked_observations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
