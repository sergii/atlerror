{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlerror.dev/schema/diagnosis-snapshot.schema.json",
  "title": "Atlerror live diagnosis snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "incident_id",
    "generated_at",
    "as_of",
    "evidence_revision",
    "next_recompute_at",
    "partitions"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "diagnosis_snapshot"},
    "incident_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "as_of": {"type": "string", "format": "date-time"},
    "evidence_revision": {"type": "integer", "minimum": 0},
    "next_recompute_at": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "date-time"}
      ]
    },
    "partitions": {
      "type": "array",
      "items": {"$ref": "#/$defs/partition"}
    }
  },
  "$defs": {
    "runtime_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "boundaries": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      },
      "minProperties": 1
    },
    "scalar": {
      "type": ["number", "string", "boolean", "null"]
    },
    "ranking": {
      "type": "object",
      "required": ["schema_version", "kind", "query", "found", "ranking_method", "candidates"],
      "properties": {
        "schema_version": {"const": "0.1"},
        "kind": {"const": "causal_ranking"},
        "query": {
          "type": "object",
          "required": ["target", "observed", "absent", "max_depth"],
          "properties": {
            "target": {"type": "string", "minLength": 1},
            "observed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "absent": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "max_depth": {"type": ["integer", "null"], "minimum": 1}
          }
        },
        "found": {"const": true},
        "ranking_method": {"type": "object"},
        "evidence_context": {"type": "object"},
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["rank", "source", "path", "factors", "reasons"]
          }
        }
      }
    },
    "probe_ranking": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "query",
        "found",
        "not_found_reason",
        "ranking_method",
        "probes"
      ],
      "properties": {
        "schema_version": {"const": "0.1"},
        "kind": {"const": "probe_ranking"},
        "query": {"type": "object"},
        "found": {"type": "boolean"},
        "not_found_reason": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["fewer_than_two_candidates", "no_discriminating_probe"]}
          ]
        },
        "ranking_method": {"type": "object"},
        "probes": {"type": "array"}
      }
    },
    "probe_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "affects_ranking",
        "platform",
        "probe_id",
        "registered",
        "executable_here",
        "unavailable_reason",
        "executor",
        "capability",
        "observation",
        "source",
        "policy"
      ],
      "properties": {
        "schema_version": {"const": "0.1"},
        "kind": {"const": "probe_execution_annotation"},
        "affects_ranking": {"const": false},
        "platform": {"type": "string", "minLength": 1},
        "probe_id": {"type": ["string", "null"]},
        "registered": {"type": ["boolean", "null"]},
        "executable_here": {"type": ["boolean", "null"]},
        "unavailable_reason": {"type": ["string", "null"]},
        "executor": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "platform"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "platform": {"type": "string", "minLength": 1}
              }
            }
          ]
        },
        "capability": {"type": ["string", "null"]},
        "observation": {"type": ["string", "null"]},
        "source": {"type": ["string", "null"]},
        "policy": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/scalar"}
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "ranking", "probe_ranking", "probe_execution"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "ranking": {"$ref": "#/$defs/ranking"},
        "probe_ranking": {"$ref": "#/$defs/probe_ranking"},
        "probe_execution": {"$ref": "#/$defs/probe_execution"}
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "observed",
        "absent",
        "active_instance_ids",
        "stale_instance_ids",
        "future_instance_ids",
        "diagnoses",
        "unranked_observations"
      ],
      "properties": {
        "scope": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/runtime_scope"}
          ]
        },
        "observed": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "absent": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "active_instance_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "stale_instance_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "future_instance_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "diagnoses": {
          "type": "array",
          "items": {"$ref": "#/$defs/diagnosis"}
        },
        "unranked_observations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
