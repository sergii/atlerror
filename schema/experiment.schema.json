{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlerror.dev/schema/experiment.schema.json",
  "title": "Atlerror Empirical Experiment",
  "type": "object",
  "required": ["id", "kind", "title", "claims", "runner", "expected_result"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^experiment\\.[a-z0-9_]+(\\.[a-z0-9_]+)+$"
    },
    "kind": { "const": "experiment" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^claim\\.[a-z0-9_]+(\\.[a-z0-9_]+)+$"
      }
    },
    "runner": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "build_context", "image"],
          "properties": {
            "type": { "const": "docker" },
            "build_context": { "type": "string", "minLength": 1 },
            "image": { "type": "string", "minLength": 1 },
            "docker_args": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "compose_file", "setup_service", "evidence_service"],
          "properties": {
            "type": { "const": "docker_compose" },
            "compose_file": { "type": "string", "minLength": 1 },
            "setup_service": { "type": "string", "minLength": 1 },
            "evidence_service": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "expected_result": {
      "type": "string",
      "enum": ["supports", "contradicts", "inconclusive"]
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
